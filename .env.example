# ---------------------------------------------------------------------------
# FAAS - example environment. Copy to .env and adjust before deploying.
# ---------------------------------------------------------------------------

# Django
DJANGO_SECRET_KEY=change-me-generate-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_TIME_ZONE=Africa/Casablanca
DJANGO_LANGUAGE_CODE=fr

# PostgreSQL
POSTGRES_DB=faas
POSTGRES_USER=faas
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Set to 1 to run on SQLite instead of PostgreSQL (tests, quick demo)
USE_SQLITE=0

# Cache - leave empty to use the in-memory cache
REDIS_URL=

# JWT lifetimes
JWT_ACCESS_MINUTES=120
JWT_REFRESH_DAYS=7

# CORS / CSRF (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Opening hours used to compute the occupancy rates
BUSINESS_HOURS_START=8
BUSINESS_HOURS_END=20
BUSINESS_DAYS_PER_WEEK=6

# Maximum number of occurrences a single recurrence may generate
MAX_RECURRENCE_OCCURRENCES=400

# Analytics cache lifetime, in seconds
ANALYTICS_CACHE_TTL=300

# Exposed ports (docker compose)
BACKEND_PORT=8000
FRONTEND_PORT=8080

# ---------------------------------------------------------------------------
# Frontend (build time - frontend/.env)
# ---------------------------------------------------------------------------
# VITE_API_URL=/api
# VITE_PROXY_TARGET=http://localhost:8000
# VITE_TIMEZONE=Africa/Casablanca
